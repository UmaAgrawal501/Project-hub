# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional for older HS256 projects; ES256 projects validate via JWKS
SUPABASE_JWT_SECRET=your-jwt-secret

# Database — use Session pooler URI from Supabase (region-specific host)
# Encode special characters in the password (@ -> %40)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres

# App
APP_ENV=development
APP_NAME=ProjectHub API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Password reset redirect (frontend page that posts token to API)
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Storage
STORAGE_BUCKET=project-files
SIGNED_UPLOAD_TTL_SECONDS=300
SIGNED_DOWNLOAD_TTL_SECONDS=120
# Optional; defaults to SUPABASE_JWT_SECRET
# UPLOAD_TOKEN_SECRET=
